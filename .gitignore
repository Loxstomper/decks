# OS
.DS_Store
Thumbs.db

# Secrets & local config (spec principles-and-invariants — secrets hygiene)
.env
.env.*
*.local
config.local.toml

# Node / frontend
node_modules/
web/node_modules/
web/dist/
*.log
npm-debug.log*

# Playwright output (generated at runtime, not committed)
web/test-results/
web/playwright-report/
# e2e runtime state file (written by global-setup, removed by teardown)
web/e2e/.e2e-state.json

# Go build output
/bin/
# The binary was once named `slides` and ignored by that name. The rename dropped
# that line, un-ignoring a stale artifact, and `git add -A` committed 14 MB of it.
# Keep the guard: an old checkout can still produce this file.
/slides
# Workspace runtime dirs, re-created on run
/decks
/shared
*.test
*.out
coverage.*

# Editors
.idea/
.vscode/
*.swp

# GoReleaser output
/dist/
