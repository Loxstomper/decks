{
  "name": "decks-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && cd .. && go build -o bin/decks ./cmd/decks && cd web && npx playwright test",
    "test:e2e:docker": "npm run build && npx playwright test",
    "test:e2e:report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.2",
    "jsdom": "30.0.0",
    "postcss": "8.5.24",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.7",
    "codemirror": "6.0.2"
  }
}
