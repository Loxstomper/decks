{
  "name": "decks-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && cd .. && go build -o bin/decks ./cmd/decks && cd web && npx playwright test",
    "test:e2e:docker": "npm run build && npx playwright test",
    "test:e2e:report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.5.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.11",
    "codemirror": "6.0.2"
  }
}
